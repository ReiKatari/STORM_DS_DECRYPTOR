<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StormDsDecryptor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:StormDsDecryptor"
    Title="STORM DS DECRYPTOR 1.3.0"
    mc:Ignorable="d">

    <Page x:Name="RootPage"
          Background="{StaticResource BgPrimaryBrush}"
          FontFamily="{StaticResource AppFontFamily}">
    <Grid x:Name="RootGrid"
          Background="{StaticResource BgPrimaryBrush}"
          AllowDrop="True"
          DragOver="RootGrid_DragOver"
          Drop="RootGrid_Drop"
          KeyDown="RootGrid_KeyDown">

        <Grid.Resources>
            <!-- Stretch ListView Items with zero default margin/padding -->
            <Style x:Key="TableListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="48" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: CUSTOM WINDOW TITLE BAR (Rule 10 & 12) ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Drag Region with High-Res Icon & App Title + Version (no 'v') -->
                <Grid x:Name="AppTitleBarDragArea" Grid.Column="0" Background="Transparent" Padding="14,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Image x:Name="ImgTitleBarIcon" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtWindowTitle"
                                   Text="STORM DS DECRYPTOR 1.3.0"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   CharacterSpacing="35"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Custom Vector Window Caption Buttons (Minimize, Maximize/Restore, Close-to-Tray) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                    <Button x:Name="BtnWinMinimize"
                            Click="BtnMinimize_Click"
                            Width="46" Height="38"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="0">
                        <Path Data="M 0,5 L 10,5"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.5"
                              Width="10" Height="10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="BtnWinMaximize"
                            Click="BtnMaximize_Click"
                            Width="46" Height="38"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="0">
                        <Path x:Name="IconMaximizePath"
                              Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.4"
                              Width="10" Height="10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="BtnWinClose"
                            Click="BtnClose_Click"
                            Width="46" Height="38"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="0"
                            PointerEntered="BtnWinClose_PointerEntered"
                            PointerExited="BtnWinClose_PointerExited">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.6"
                              Width="10" Height="10"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: BRAND HEADER BANNER & APPEARANCE BAR (Rule 12) ==================== -->
        <Border Grid.Row="1"
                Margin="18,12,18,8"
                Padding="18,14"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- High-Res 48x48 App Logo + STORM (Accent) DS DECRYPTOR (No Version!) + Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="52" Height="52"
                            CornerRadius="12"
                            Background="{StaticResource BgSecondaryBrush}"
                            BorderBrush="{StaticResource AccentPrimaryBrush}"
                            BorderThickness="1.5"
                            Padding="4">
                        <Image x:Name="ImgHeaderLogo" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="22" FontWeight="ExtraBold" CharacterSpacing="25">
                            <Run Text="STORM" Foreground="{StaticResource AccentPrimaryBrush}" />
                            <Run x:Name="RunHeaderAppName" Text=" DS DECRYPTOR" Foreground="{StaticResource TextPrimaryBrush}" />
                        </TextBlock>
                        <TextBlock x:Name="TxtSubHeader"
                                   Text="Комплекс расшифровки Nintendo DS / DSi / DSiWare / 3DS CIA / TAD / NUS"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12.5"
                                   FontWeight="Medium" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Appearance Controls: Theme, Accent, Font, Language + About -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Theme Selector -->
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="LblTheme" Text="Тема" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox x:Name="CmbTheme" Width="136" Height="34" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" SelectionChanged="CmbTheme_SelectionChanged" />
                    </StackPanel>

                    <!-- Accent Selector -->
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="LblAccent" Text="Акцент" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox x:Name="CmbAccent" Width="116" Height="34" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" SelectionChanged="CmbAccent_SelectionChanged" />
                    </StackPanel>

                    <!-- Font Selector -->
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="LblFont" Text="Шрифт" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox x:Name="CmbFont" Width="148" Height="34" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" SelectionChanged="CmbFont_SelectionChanged" />
                    </StackPanel>

                    <!-- Language Selector -->
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="LblLang" Text="Язык" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox x:Name="CmbLang" Width="138" Height="34" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" SelectionChanged="CmbLang_SelectionChanged" />
                    </StackPanel>

                    <!-- Check Updates Button -->
                    <Button x:Name="BtnCheckUpdate"
                            Click="BtnCheckUpdate_Click"
                            Height="34"
                            Margin="0,17,0,0"
                            Padding="12,0"
                            Background="{StaticResource BgSecondaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            FontWeight="SemiBold"
                            FontSize="12.5"
                            Content="🔄" />

                    <!-- About Button -->
                    <Button x:Name="BtnAbout"
                            Click="BtnAbout_Click"
                            Height="34"
                            Margin="0,17,0,0"
                            Padding="12,0"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="8"
                            FontWeight="Bold"
                            FontSize="12.5"
                            Content="?" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: MAIN WORKSPACE (TOOLBAR + TAB SWITCHER + TABLES + SETTINGS) ==================== -->
        <Grid Grid.Row="2" Margin="18,0,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Action Toolbar + View Switcher + Live Search -->
            <Border Grid.Row="0"
                    Margin="0,0,0,8"
                    Padding="14,10"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Action Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnAddFiles"
                                Click="BtnAddFiles_Click"
                                Height="36" Padding="14,0"
                                Background="{StaticResource AccentPrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="8"
                                FontWeight="Bold">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="➕" />
                                <TextBlock x:Name="TxtBtnAddFiles" Text="Добавить ROM-ы" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnAddFolder"
                                Click="BtnAddFolder_Click"
                                Height="36" Padding="14,0"
                                Background="{StaticResource BgSecondaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="📁" />
                                <TextBlock x:Name="TxtBtnAddFolder" Text="Добавить папку" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnClearQueue"
                                Click="BtnClearQueue_Click"
                                Height="36" Padding="14,0"
                                Background="{StaticResource BgSecondaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="🗑" />
                                <TextBlock x:Name="TxtBtnClearQueue" Text="Очистить список" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnExportReport"
                                Click="BtnExportReport_Click"
                                Height="36" Padding="12,0"
                                Background="{StaticResource BgSecondaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📊" />
                                <TextBlock x:Name="TxtBtnExport" Text="Экспорт CSV/JSON" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Center: Live Search Box -->
                    <Grid Grid.Column="1" Margin="14,0" MaxWidth="340" HorizontalAlignment="Stretch">
                        <TextBox x:Name="TxtSearch"
                                 Height="36"
                                 Padding="12,6,30,6"
                                 CornerRadius="8"
                                 Background="{StaticResource BgSecondaryBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                 PlaceholderText="🔍 Поиск по названию, коду, региону..."
                                 TextChanged="TxtSearch_TextChanged" />
                    </Grid>

                    <!-- Right: Tab Switcher (Queue vs History) + Live Stats Badges -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Padding="10,5" CornerRadius="8" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run x:Name="LblStatTotal" Text="Всего:" />
                                    <Run x:Name="TxtStatTotal" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" />
                                </TextBlock>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run x:Name="LblStatEnc" Text="Зашифр.:" />
                                    <Run x:Name="TxtStatEnc" Text="0" Foreground="#F59E0B" FontWeight="Bold" />
                                </TextBlock>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run x:Name="LblStatDone" Text="Готово:" />
                                    <Run x:Name="TxtStatDone" Text="0" Foreground="#10B981" FontWeight="Bold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnTabQueue"
                                Click="BtnTabQueue_Click"
                                Height="36" Padding="14,0"
                                Background="{StaticResource AccentPrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                CornerRadius="8"
                                FontWeight="Bold"
                                Content="🎮 Очередь игр (0)" />

                        <Button x:Name="BtnTabHistory"
                                Click="BtnTabHistory_Click"
                                Height="36" Padding="14,0"
                                Background="{StaticResource BgSecondaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                FontWeight="SemiBold"
                                Content="📜 История (0)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== TABLE CONTAINER (QUEUE & HISTORY WITH VERTICAL DIVIDERS - Rule 11) ==================== -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <!-- VIEW 1: QUEUE TABLE -->
                    <Grid x:Name="PanelQueueView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Queue Table Column Headers with Visible Vertical Dividers & Sorting -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1.5"
                                CornerRadius="12,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="215" />
                                    <ColumnDefinition Width="148" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="ICON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <Button x:Name="BtnSortName" Grid.Column="1" Click="BtnSortName_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0">
                                    <TextBlock x:Name="HdrColFile" Text="ФАЙЛ / ВНУТРЕННЕЕ НАЗВАНИЕ ↕" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Button>
                                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <Button x:Name="BtnSortCode" Grid.Column="2" Click="BtnSortCode_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,0">
                                    <TextBlock x:Name="HdrColCode" Text="КОД ↕" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Button>
                                <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrColRegion" Grid.Column="3" Text="РЕГИОН" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <Button x:Name="BtnSortFormat" Grid.Column="4" Click="BtnSortFormat_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,0">
                                    <TextBlock x:Name="HdrColFormat" Text="ФОРМАТ ↕" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Button>
                                <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <Button x:Name="BtnSortSize" Grid.Column="5" Click="BtnSortSize_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,0">
                                    <TextBlock x:Name="HdrColSize" Text="РАЗМЕР ↕" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Button>
                                <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <Button x:Name="BtnSortStatus" Grid.Column="6" Click="BtnSortStatus_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,0">
                                    <TextBlock x:Name="HdrColStatus" Text="СТАТУС ↕" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Button>
                                <Rectangle Grid.Column="6" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrColActions" Grid.Column="7" Text="ДЕЙСТВИЯ" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Queue Rows ListView -->
                        <ListView x:Name="ListGames"
                                  Grid.Row="1"
                                  SelectionMode="None"
                                  ItemContainerStyle="{StaticResource TableListViewItemStyle}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            Background="Transparent">
                                        <Grid MinHeight="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="215" />
                                                <ColumnDefinition Width="148" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Col 0: 32x32 Nearest-Neighbor Game Cartridge Icon -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="7" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding IconSource}" Width="32" Height="32" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <!-- Col 1: File Name & Banner Title -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Padding="12,4">
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding InternalTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <!-- Col 2: Game Code -->
                                            <Border Grid.Column="2" Padding="7,3" CornerRadius="6" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameCode}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12" FontWeight="Bold" />
                                            </Border>
                                            <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <!-- Col 3: Region -->
                                            <Border Grid.Column="3" Padding="7,3" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RegionCode}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" FontWeight="Bold" />
                                            </Border>
                                            <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <!-- Col 4: Format -->
                                            <TextBlock Grid.Column="4" Text="{Binding FormatType}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <!-- Col 5: Size -->
                                            <TextBlock Grid.Column="5" Text="{Binding FileSizeFormatted}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <!-- Col 6: Status -->
                                            <StackPanel Grid.Column="6" VerticalAlignment="Center" Padding="10,4" Spacing="4">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BgSecondaryBrush}" CornerRadius="2" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="6" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <!-- Col 7: Row Actions (Inspect, Decrypt Single, Open Folder, Remove) -->
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Click="BtnInspectRom_Click" Tag="{Binding}" Width="30" Height="30" Padding="0" CornerRadius="6" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Content="ℹ" ToolTipService.ToolTip="ROM &amp; Banner Inspector" />
                                                <Button Click="BtnProcessSingle_Click" Tag="{Binding}" Width="30" Height="30" Padding="0" CornerRadius="6" Background="{StaticResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0" Content="▶" ToolTipService.ToolTip="Decrypt / Process ROM" />
                                                <Button Click="BtnOpenLocation_Click" Tag="{Binding}" Width="30" Height="30" Padding="0" CornerRadius="6" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Content="📂" ToolTipService.ToolTip="Show in Explorer" />
                                                <Button Click="BtnRemoveSingle_Click" Tag="{Binding}" Width="30" Height="30" Padding="0" CornerRadius="6" Background="{StaticResource BgSecondaryBrush}" Foreground="#F43F5E" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Content="✕" ToolTipService.ToolTip="Remove from Queue" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Empty Dropzone Overlay -->
                        <Border x:Name="EmptyStateOverlay"
                                Grid.Row="1"
                                Margin="28"
                                Padding="28"
                                CornerRadius="14"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="2"
                                Background="Transparent"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="🎮" FontSize="44" HorizontalAlignment="Center" />
                                <TextBlock x:Name="TxtDropTitle"
                                           Text="Перетащите файлы (.nds, .dsi, .srl, .app, .cia, .tad, title.tmd) или папки сюда"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           TextAlignment="Center" />
                                <TextBlock x:Name="TxtDropSub"
                                           Text="Автоматическое распознавание DSiWare Modcrypt, стандарта NDS, CIA, TAD и дампов NUS"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- VIEW 2: HISTORY TABLE -->
                    <Grid x:Name="PanelHistoryView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- History Header with Visible Vertical Dividers -->
                        <Border Grid.Row="0"
                                Background="{StaticResource BgSecondaryBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1.5"
                                CornerRadius="12,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="ICON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrHistDate" Grid.Column="1" Text="ДАТА / ВРЕМЯ" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrHistFile" Grid.Column="2" Text="ИМЯ ФАЙЛА" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0" />
                                <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrHistCode" Grid.Column="3" Text="КОД" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrHistFormat" Grid.Column="4" Text="ФОРМАТ" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrHistSize" Grid.Column="5" Text="РАЗМЕР" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrHistResult" Grid.Column="6" Text="РЕЗУЛЬТАТ" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Grid.Column="6" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" />

                                <TextBlock x:Name="HdrHistActions" Grid.Column="7" Text="ПАПКА" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ListView x:Name="ListHistory"
                                  Grid.Row="1"
                                  SelectionMode="None"
                                  ItemContainerStyle="{StaticResource TableListViewItemStyle}"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Background="Transparent">
                                        <Grid MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding IconSource}" Width="32" Height="32" Stretch="UniformToFill" />
                                            </Border>
                                            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Padding="12,4">
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding OutputPath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <Border Grid.Column="3" Padding="7,3" CornerRadius="6" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameCode}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12" FontWeight="Bold" />
                                            </Border>
                                            <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <TextBlock Grid.Column="4" Text="{Binding FormatType}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Rectangle Grid.Column="4" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <TextBlock Grid.Column="5" Text="{Binding FileSizeFormatted}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Rectangle Grid.Column="5" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <TextBlock Grid.Column="6" Text="{Binding ResultStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Rectangle Grid.Column="6" Width="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Fill="{StaticResource BorderSubtleBrush}" Opacity="0.7" />

                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Click="BtnHistoryOpenLocation_Click" Tag="{Binding}" Width="32" Height="30" Padding="0" CornerRadius="6" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Content="📂" ToolTipService.ToolTip="Show in Explorer" />
                                                <Button Click="BtnHistoryRemoveSingle_Click" Tag="{Binding}" Width="32" Height="30" Padding="0" CornerRadius="6" Background="{StaticResource BgSecondaryBrush}" Foreground="#F43F5E" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Content="✕" ToolTipService.ToolTip="Delete Entry" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Border Grid.Row="2" Padding="12,8" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                            <Button x:Name="BtnClearHistory" Click="BtnClearHistory_Click" HorizontalAlignment="Right" Height="32" Padding="14,0" CornerRadius="7" Background="{StaticResource BgCardBrush}" Foreground="#F43F5E" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" FontWeight="SemiBold" Content="🗑 Очистить историю" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== BOTTOM SETTINGS & OUTPUT BAR ==================== -->
            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="16,12"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Processing Mode + Checkboxes -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="LblMode" Text="Режим:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox x:Name="CmbMode" Width="250" Height="36" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8" SelectionChanged="CmbMode_SelectionChanged" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" Spacing="4" Margin="4,0,0,0">
                            <CheckBox x:Name="ChkVerifyCrc" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Content="Пересчёт и проверка CRC16" Checked="Options_Changed" Unchecked="Options_Changed" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <CheckBox x:Name="ChkCompatibility" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Content="Патч совместимости (NDS / TWiLight)" Checked="Options_Changed" Unchecked="Options_Changed" />
                                <CheckBox x:Name="ChkBackup" IsChecked="False" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" Content="Создавать резервную копию (.bak)" Checked="Options_Changed" Unchecked="Options_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Output Directory Selector -->
                    <Grid x:Name="PanelOutputFolder" Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LblOutputFolder" Grid.Row="0" Text="Папка сохранения:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutputDir" Grid.Column="0" Height="36" IsReadOnly="True" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" CornerRadius="8,0,0,8" FontSize="12" VerticalContentAlignment="Center" />
                            <Button x:Name="BtnBrowseOut" Grid.Column="1" Click="BtnBrowseOut_Click" Height="36" Padding="12,0" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1,1,1,1" CornerRadius="0" FontWeight="SemiBold" Content="Обзор..." />
                            <Button x:Name="BtnOpenOut" Grid.Column="2" Click="BtnOpenOut_Click" Height="36" Padding="12,0" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0" FontWeight="SemiBold" Content="📂" />
                        </Grid>
                    </Grid>

                    <!-- Primary Action: DECRYPT ALL -->
                    <Button x:Name="BtnStartBatch"
                            Grid.Column="2"
                            Click="BtnStartBatch_Click"
                            Height="48"
                            Padding="24,0"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="10"
                            FontSize="14.5"
                            FontWeight="ExtraBold">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="⚡" FontSize="16" />
                            <TextBlock x:Name="TxtBtnStartBatch" Text="РАСШИФРОВАТЬ ВСЕ" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ROW 3: STATUS & PROGRESS BAR FOOTER ==================== -->
        <Border Grid.Row="3"
                Padding="18,8"
                Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatusFooter"
                           Grid.Column="0"
                           Text="Готов к работе. Перетащите образы игр в окно программы."
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <ProgressBar x:Name="PbTotal"
                             Grid.Column="1"
                             Value="0"
                             Maximum="100"
                             Height="8"
                             Margin="16,0"
                             CornerRadius="4"
                             Foreground="{StaticResource AccentPrimaryBrush}"
                             Background="{StaticResource BgCardBrush}"
                             VerticalAlignment="Center" />

                <TextBlock x:Name="TxtFooterBrand"
                           Grid.Column="2"
                           Text="STORM TEAM • AES-128-CTR Engine"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11.5"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ==================== MODAL OVERLAY 1: ROM & BANNER INSPECTOR (Rule 16 ESC-closeable) ==================== -->
        <Grid x:Name="OverlayInspector" Grid.RowSpan="4" Background="#B805040A" Visibility="Collapsed">
            <Border Width="680" MaxHeight="620"
                    Padding="24"
                    CornerRadius="16"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentPrimaryBrush}"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="76" Height="76" CornerRadius="12" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1.5" Padding="6" Margin="0,0,16,0">
                            <Image x:Name="ImgInspectorBanner" Width="64" Height="64" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock x:Name="TxtInspectorTitle" Text="ROM &amp; Banner Inspector" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtInspectorSubtitle" Text="" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Click="BtnCloseInspector_Click" Width="34" Height="34" CornerRadius="8" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Content="✕" VerticalAlignment="Top" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <TextBox x:Name="TxtInspectorDetails"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Cascadia Code, Consolas"
                                 FontSize="12.5"
                                 Padding="14"
                                 CornerRadius="10"
                                 Background="{StaticResource BgSecondaryBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderSubtleBrush}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
                        <Button x:Name="BtnCopyInspector" Click="BtnCopyInspector_Click" Height="36" Padding="16,0" CornerRadius="8" Background="{StaticResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" Content="📋 Копировать отчёт" />
                        <Button Click="BtnCloseInspector_Click" Height="36" Padding="18,0" CornerRadius="8" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" FontWeight="SemiBold" Content="ОК (ESC)" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== MODAL OVERLAY 2: UPDATE DIALOG (Rule 9 & 16) ==================== -->
        <Grid x:Name="OverlayUpdate" Grid.RowSpan="4" Background="#B805040A" Visibility="Collapsed">
            <Border Width="540"
                    Padding="24"
                    CornerRadius="16"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentPrimaryBrush}"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="TxtUpdateHeader" Text="Доступно обновление" FontSize="19" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="TxtUpdateSub" Text="" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                    <TextBox x:Name="TxtUpdateNotes" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="180" FontFamily="Cascadia Code, Consolas" FontSize="12" Padding="12" CornerRadius="10" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" />
                    <ProgressBar x:Name="PbUpdateDownload" Visibility="Collapsed" Value="0" Maximum="100" Height="8" CornerRadius="4" Foreground="{StaticResource AccentPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="BtnUpdateLater" Click="BtnUpdateLater_Click" Height="38" Padding="18,0" CornerRadius="8" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" FontWeight="SemiBold" Content="Позже" />
                        <Button x:Name="BtnUpdateConfirm" Click="BtnUpdateConfirm_Click" Height="38" Padding="22,0" CornerRadius="8" Background="{StaticResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0" FontWeight="ExtraBold" Content="Обновить" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL OVERLAY 3: DUPLICATE PROMPT DIALOG (Rule 16) ==================== -->
        <Grid x:Name="OverlayDuplicate" Grid.RowSpan="4" Background="#B805040A" Visibility="Collapsed">
            <Border Width="520"
                    Padding="24"
                    CornerRadius="16"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentPrimaryBrush}"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="TxtDupTitle" Text="Файл уже существует" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="TxtDupMessage" Text="" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <CheckBox x:Name="ChkDupApplyAll" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Content="Применить ко всем" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="BtnDupOverwrite" Click="BtnDupOverwrite_Click" Height="36" Padding="16,0" CornerRadius="8" Background="{StaticResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" Content="Заменить" />
                        <Button x:Name="BtnDupSkip" Click="BtnDupSkip_Click" Height="36" Padding="16,0" CornerRadius="8" Background="{StaticResource BgSecondaryBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" FontWeight="SemiBold" Content="Пропустить" />
                        <Button x:Name="BtnDupCancel" Click="BtnDupCancel_Click" Height="36" Padding="16,0" CornerRadius="8" Background="{StaticResource BgSecondaryBrush}" Foreground="#F43F5E" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" FontWeight="SemiBold" Content="Отмена" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== MODAL OVERLAY 4: MESSAGE / ABOUT DIALOG (Rule 16) ==================== -->
        <Grid x:Name="OverlayMessage" Grid.RowSpan="4" Background="#B805040A" Visibility="Collapsed">
            <Border Width="500"
                    Padding="24"
                    CornerRadius="16"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource AccentPrimaryBrush}"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Image x:Name="ImgModalLogo" Width="36" Height="36" />
                        <TextBlock x:Name="TxtModalTitle" Text="STORM DS DECRYPTOR" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TxtModalMessage" Text="" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="21" />
                    <Button x:Name="BtnModalOk" Click="BtnModalOk_Click" HorizontalAlignment="Right" Height="36" Padding="24,0" CornerRadius="8" Background="{StaticResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0" FontWeight="Bold" Content="ОК" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
    </Page>
</Window>
