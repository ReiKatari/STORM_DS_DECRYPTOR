<Window x:Class="StormDsiDecryptor.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STORM DSI DECRYPTOR - Обновление"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource ThemeCardBg}"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="{DynamicResource StormFontFamily}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource ThemeCardBg}"
            BorderBrush="{DynamicResource ThemeAccent}"
            BorderThickness="1.5"
            CornerRadius="12"
            MinWidth="540"
            MaxWidth="620"
            Margin="0">

        <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Version Info -->
                <RowDefinition Height="Auto" /> <!-- Changelog -->
                <RowDefinition Height="Auto" /> <!-- Progress Bar (during download) -->
                <RowDefinition Height="Auto" /> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="AppIcon.ico" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock FontSize="14.5" VerticalAlignment="Center">
                        <Run Text="STORM" FontWeight="Black" Foreground="{DynamicResource ThemeAccent}" />
                        <Run Text=" DSI DECRYPTOR" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" />
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnClose" Click="BtnClose_Click"
                        Width="28" Height="28" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                     <Setter TargetName="bd" Property="Background" Value="#25FF3344" />
                                     <Setter Property="Foreground" Value="#FF4455" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    ✕
                </Button>
            </Grid>

            <!-- Version Info & Header Banner -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeCardBorder}" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource ThemeAccentSoft}"
                            BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1.2"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderBanner" Text="Доступна новая версия программы!" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LblCurrent" Text="Текущая версия:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,6,0" />
                            <TextBlock x:Name="TxtCurrentVer" Text="1.1.9" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,14,0" />
                            <TextBlock Text="➔" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,0,14,0" />
                            <TextBlock x:Name="LblNew" Text="Новая версия:" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,6,0" />
                            <TextBlock x:Name="TxtNewVer" Text="1.2.0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                            <TextBlock x:Name="TxtFileSize" Text=" (~140 МБ)" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Changelog Section -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock x:Name="LblChangelog" Text="Список изменений:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,6" />
                <Border Background="#120E22" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="TxtChangelog" Text="Загрузка списка изменений..." FontSize="12" LineHeight="18" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Progress Panel (During Download) -->
            <StackPanel Grid.Row="3" x:Name="PanelProgress" Visibility="Collapsed" Margin="0,0,0,14">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtProgressStatus" Text="Загрузка обновления..." FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" />
                    <TextBlock Grid.Column="1" x:Name="TxtProgressPercent" Text="0%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" />
                </Grid>
                <ProgressBar x:Name="BarDownload" Height="10" Minimum="0" Maximum="100" Value="0"
                             Background="#1AFFFFFF" Foreground="{DynamicResource ThemeAccent}" BorderThickness="0">
                    <ProgressBar.Clip>
                        <RectangleGeometry RadiusX="5" RadiusY="5" Rect="0,0,576,10" />
                    </ProgressBar.Clip>
                </ProgressBar>
            </StackPanel>

            <!-- Dialog Actions -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLater" Content="Позже" Width="110" Height="36" Margin="0,0,10,0"
                        Style="{StaticResource StormButton}" Click="BtnLater_Click" />
                <Button x:Name="BtnUpdate" Content="⚡ Обновить сейчас" Width="170" Height="36"
                        Style="{StaticResource StormHeroButton}" Click="BtnUpdate_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
